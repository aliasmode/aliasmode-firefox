   }
 
   nsRect r = GetInnerScreenRect();
-  return nsPresContext::AppUnitsToFloatCSSPixels(r.x);
+  float x = nsPresContext::AppUnitsToFloatCSSPixels(r.x);
+  if (aCallerType != CallerType::System) {
+    x += ClaimedScreenOffset().x.value;
+  }
+  return x;
 }
 
