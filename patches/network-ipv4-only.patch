+bool NetAddr::IsUnreachableOnIPv4OnlyNetwork() const {
+  if (raw.family != AF_INET6 || !MaskConfig::CheckBool("network:ipv4Only")) {
+    return false;
+  }
+  // Loopback, the any address, IPv4-mapped and link-local (fe80::/10)
+  // addresses need no IPv6 route, so they work on an IPv4-only network too.
+  return !IsIPAddrAny() && !IsLoopbackAddr() && !IsIPAddrV4Mapped() &&
+         (ntohs(inet6.ip.u16[0]) & 0xffc0) != 0xfe80;
+}
