+  // AliasMode: a persona's fonts from its font pack are in no OS font cache,
+  // so each family's faces and character maps were loaded on first use, and a
+  // page paid a synchronous round trip to this process per family (measured on
+  // Windows with the macOS pack: 9 ms per font cold, 4.5 ms with the families
+  // loaded). Load the persona's families here, in idle time after startup.
+  if (XRE_IsParentProcess() && SharedFontList() &&
+      MaskConfig::HasFontAllowlist() &&
+      !MaskConfig::GetString("aliasmode:fontsDir").value_or("").empty()) {
+    WarmPersonaFamilies(0);
+  }
+
