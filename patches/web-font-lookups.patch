 }
 
+void gfxPlatformFontList::WarmPersonaFamilies(size_t aStart) {
+  NS_DispatchToMainThreadQueue(
+      NS_NewRunnableFunction(
+          "gfxPlatformFontList::WarmPersonaFamilies",
+          [aStart] {
+            gfxPlatformFontList* pfl = PlatformFontList(false);
+            if (!pfl ||
+                AppShutdown::IsInOrBeyond(ShutdownPhase::AppShutdownConfirmed)) {
+              return;
+            }
+            AutoLock lock(pfl->mLock);
+            fontlist::FontList* list = pfl->SharedFontList();
+            if (!list) {
+              return;
+            }
+            const auto& names = MaskConfig::FontAllowlist();
+            const TimeStamp start = TimeStamp::Now();
+            size_t i = aStart;
+            while (i < names.size()) {
+              nsAutoCString key(names[i].c_str());
+              ++i;
+              fontlist::Family* family = list->FindFamily(key);
+              if (family && !family->IsFullyInitialized()) {
+                (void)pfl->InitializeFamily(family, /* aLoadCmaps */ true);
+              }
+              // A few milliseconds at a time, so input never waits on it.
+              if ((TimeStamp::Now() - start).ToMilliseconds() > 8) {
+                break;
+              }
+            }
+            if (i < names.size()) {
+              pfl->WarmPersonaFamilies(i);
+            }
+          }),
+      EventQueuePriority::Idle);
+}
