 // ============================================================================
 // ============================================================================
 // Randomization Stuff
+
+// The browsing session key of a profile with aliasmode:canvasSeed: the same
+// version 4 UUID for the same seed and origin attributes on every launch.
+// Without a seed it is a fresh UUID, as stock.
+static nsID AliasModeBrowsingSessionKey(const nsACString& aOASuffix) {
+  const uint32_t seed =
+      MaskConfig::GetUint32("aliasmode:canvasSeed").value_or(0);
+  if (!seed) {
+    return nsID::GenerateUUID();
+  }
+  auto mix = [](uint64_t aValue) {
+    aValue ^= aValue >> 30;
+    aValue *= 0xbf58476d1ce4e5b9ull;
+    aValue ^= aValue >> 27;
+    aValue *= 0x94d049bb133111ebull;
+    return aValue ^ (aValue >> 31);
+  };
+  uint64_t state = mix(uint64_t(seed) ^ 0x5be0cd19137e2179ull);
+  for (const char* c = aOASuffix.BeginReading(); c != aOASuffix.EndReading();
+       ++c) {
+    state = mix(state ^ uint8_t(*c));
+  }
+  const uint64_t words[2] = {mix(state + 0x9e3779b97f4a7c15ull),
+                             mix(state + 2 * 0x9e3779b97f4a7c15ull)};
+  nsID key;
+  static_assert(sizeof(key) == sizeof(words));
+  memcpy(&key, words, sizeof(key));
+  key.m2 = uint16_t((key.m2 & 0x0fff) | 0x4000);
+  key.m3[0] = uint8_t((key.m3[0] & 0x3f) | 0x80);
+  return key;
+}
