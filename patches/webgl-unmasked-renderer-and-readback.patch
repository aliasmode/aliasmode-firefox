+// A copy of a snapshot with the profile's readback noise
+// (AliasModeReadbackNoise.h), leaving the snapshot itself as drawn.
+static RefPtr<gfx::DataSourceSurface> WithReadbackNoise(
+    gfx::DataSourceSurface* aSurface, bool aPremultiplied) {
+  RefPtr<gfx::DataSourceSurface> copy =
+      gfx::CreateDataSourceSurfaceByCloning(aSurface);
+  if (!copy) {
+    return aSurface;
+  }
+  gfx::DataSourceSurface::ScopedMap map(copy,
+                                        gfx::DataSourceSurface::READ_WRITE);
+  if (!map.IsMapped()) {
+    return aSurface;
+  }
+  readback_noise::Apply(map.GetData(), map.GetStride(), copy->GetSize().width,
+                        copy->GetSize().height,
+                        copy->GetFormat() == gfx::SurfaceFormat::B8G8R8X8
+                            ? readback_noise::kBGRX
+                            : readback_noise::kBGRA,
+                        aPremultiplied);
+  return copy;
+}
