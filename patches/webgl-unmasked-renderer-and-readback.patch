+void ClientWebGLContext::ApplyReadbackNoise(const webgl::ReadPixelsDesc& desc,
+                                            const Span<uint8_t> dest) const {
+  if (!mRasterized || !readback_noise::Seed() ||
+      desc.pi.format != LOCAL_GL_RGBA ||
+      desc.pi.type != LOCAL_GL_UNSIGNED_BYTE || !desc.size.x || !desc.size.y) {
+    return;
+  }
+  RefPtr<webgl::NotLostData> notLost(mNotLost);
+  if (!notLost) {
+    return;
+  }
+  if (!State().mBoundReadFb) {
+    // DrawingBufferSize() only caches the size it asks the host for.
+    const auto size =
+        const_cast<ClientWebGLContext*>(this)->DrawingBufferSize();
+    if (readback_noise::Exempt(int32_t(size.x), int32_t(size.y))) {
+      return;
+    }
+  }
+  // An edge pixel's key needs its neighbours, so read the rectangle again with
+  // a one-pixel border. Pixels outside the framebuffer stay transparent black.
+  webgl::ReadPixelsDesc wide;
+  wide.srcOffset = {desc.srcOffset.x - 1, desc.srcOffset.y - 1};
+  wide.size = {desc.size.x + 2, desc.size.y + 2};
+  const size_t wideStride = size_t(wide.size.x) * 4;
+  const size_t wideBytes = wideStride * wide.size.y;
+  const auto clean = MakeUnique<uint8_t[]>(wideBytes);
+  if (!DoReadPixels(wide, Span<uint8_t>(clean.get(), wideBytes))) {
+    return;
+  }
+  // GL rows run bottom-up; the image a page sees, and so the key, top-down.
+  const readback_noise::Image image{
+      clean.get() + wideStride * (wide.size.y - 1), -ptrdiff_t(wideStride),
+      int32_t(wide.size.x), int32_t(wide.size.y), readback_noise::kRGBA};
+  const auto& packing = desc.packState;
+  const size_t rowPixels = packing.rowLength ? packing.rowLength : desc.size.x;
+  const size_t alignment = packing.alignmentInTypeElems;
+  const size_t stride = (rowPixels * 4 + alignment - 1) / alignment * alignment;
+  const size_t top = (packing.skipRows + desc.size.y - 1) * stride +
+                     packing.skipPixels * size_t(4);
+  if (top + desc.size.x * size_t(4) > dest.size()) {
+    return;
+  }
+  readback_noise::ApplyToCopy(image, 1, 1, dest.data() + top,
+                              -ptrdiff_t(stride), int32_t(desc.size.x),
+                              int32_t(desc.size.y), readback_noise::kRGBA,
+                              notLost->info.options.premultipliedAlpha);
+}
