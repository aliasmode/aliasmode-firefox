diff --git a/toolkit/components/resistfingerprinting/nsRFPService.cpp b/toolkit/components/resistfingerprinting/nsRFPService.cpp
--- a/toolkit/components/resistfingerprinting/nsRFPService.cpp
+++ b/toolkit/components/resistfingerprinting/nsRFPService.cpp
@@ -3209,25 +3209,19 @@
 /* static */
 CSSIntRect nsRFPService::GetSpoofedScreenAvailSize(const nsRect& aRect,
                                                    float aScale,
-                                                   bool aIsFullscreen) {
-  int spoofedHeightOffset = aIsFullscreen ? 0 :
-#ifdef XP_WIN
-                                          48;
-#elif defined(XP_MACOSX)
-                                          76;
-#else
-                                          // Linux, Android and other platforms
-                                0;
-#endif
+                                                   bool aIsFullscreen,
+                                                   const nsAString& aPlatform) {
+  const bool isWindows = StringBeginsWith(aPlatform, u"Win"_ns);
+  const bool isMac = StringBeginsWith(aPlatform, u"Mac"_ns);
+  // Linux, Android and other platforms have no offset.
+  int spoofedHeightOffset = aIsFullscreen ? 0
+                            : isWindows   ? 48
+                            : isMac       ? 76
+                                          : 0;
   spoofedHeightOffset =
       NS_lround(float(spoofedHeightOffset) / aScale * AppUnitsPerCSSPixel());
 
-  int spoofedHeightStart = aIsFullscreen ? 0 :
-#ifdef XP_MACOSX
-                                         25;
-#else
-                                         0;
-#endif
+  int spoofedHeightStart = aIsFullscreen || !isMac ? 0 : 25;
   spoofedHeightStart =
       NS_lround(float(spoofedHeightStart) / aScale * AppUnitsPerCSSPixel());
 
