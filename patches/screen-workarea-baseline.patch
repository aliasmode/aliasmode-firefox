   // Camoufox: the per-context API sets one size, so the available rect is the
   // whole screen. That matches the generated fingerprints, whose availWidth /
   // availHeight equal width / height, and keeps availWidth <= width true.
-  if (uint32_t w = 0, h = 0; ScreenDimensionManager::GetDimensions(
