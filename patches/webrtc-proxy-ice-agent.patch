+// Runs aStep on the main thread at aDeadline. A timer may fire up to an eighth
+// of its delay late to be bundled with others, so this waits in steps of at
+// most 500 ms, each toward the same deadline, to end where nICEr's timers do.
+void FakeIceRunAt(TimeStamp aDeadline, std::function<void()>&& aStep) {
+  const double remaining = (aDeadline - TimeStamp::Now()).ToMilliseconds();
+  if (remaining <= 0) {
+    aStep();
+    return;
+  }
+  const uint32_t wait = static_cast<uint32_t>(std::ceil(std::min(remaining, 500.0)));
+  GetMainThreadSerialEventTarget()->DelayedDispatch(
+      NS_NewRunnableFunction("PeerConnectionImpl::FakeIceRunAt",
+                             [aDeadline, step = std::move(aStep)]() mutable {
+                               FakeIceRunAt(aDeadline, std::move(step));
+                             }),
+      wait);
