diff --git a/dom/canvas/AliasModeReadbackNoise.h b/dom/canvas/AliasModeReadbackNoise.h
new file mode 100644
--- /dev/null
+++ b/dom/canvas/AliasModeReadbackNoise.h
@@ -0,0 +1,156 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef DOM_CANVAS_ALIASMODEREADBACKNOISE_H_
+#define DOM_CANVAS_ALIASMODEREADBACKNOISE_H_
+
+#include <cstddef>
+#include <cstdint>
+
+#include "MaskConfig.hpp"
+
+// Per-profile readback noise for canvas and WebGL pixels (aliasmode:canvasSeed).
+//
+// Profiles on one machine share a GPU, a rasterizer and fonts, so without this
+// they read back identical pixels. With a seed, an eligible pixel reads back
+// with the lowest bit of red, green and blue replaced by bits drawn from the
+// seed and the pixel's 3x3 neighbourhood with those lowest bits dropped:
+//
+// - The answer depends on content only, never on position or on the call, so
+//   every read path, every sub-rectangle and every pixel-aligned copy of the
+//   same pixels agrees, and a profile reads the same bytes on every launch.
+// - Reading, writing back and reading again changes nothing: the step only
+//   touches the bits the key ignores.
+// - Only opaque pixels that differ from all four direct neighbours are
+//   eligible: anti-aliased edges and blends, where rasterizers differ between
+//   machines. Flat fills, rectangle edges, gradients along one axis and
+//   transparent pixels read back exactly as drawn.
+namespace mozilla::readback_noise {
+
+inline uint64_t Mix(uint64_t aValue) {
+  aValue ^= aValue >> 30;
+  aValue *= 0xbf58476d1ce4e5b9ull;
+  aValue ^= aValue >> 27;
+  aValue *= 0x94d049bb133111ebull;
+  return aValue ^ (aValue >> 31);
+}
+
+// The profile's seed; zero leaves every readback stock.
+inline uint64_t Seed() {
+  static const uint64_t seed = [] {
+    const uint64_t value =
+        MaskConfig::GetUint32("aliasmode:canvasSeed").value_or(0);
+    return value ? Mix(value ^ 0x9e3779b97f4a7c15ull) : 0;
+  }();
+  return seed;
+}
+
+// Byte offsets of the channels in a 4-byte pixel. A negative alpha offset
+// means the format has no alpha, and every pixel is opaque.
+struct Layout {
+  int8_t r, g, b, a;
+};
+inline constexpr Layout kBGRA{2, 1, 0, 3};
+inline constexpr Layout kBGRX{2, 1, 0, -1};
+inline constexpr Layout kRGBA{0, 1, 2, 3};
+
+// Pixels as the page sees them: `origin` is the top-left pixel and rows are
+// `stride` bytes apart (negative for the bottom-up rows of a GL readback).
+struct Image {
+  const uint8_t* origin;
+  ptrdiff_t stride;
+  int32_t width;
+  int32_t height;
+  Layout layout;
+
+  const uint8_t* At(int32_t aX, int32_t aY) const {
+    return origin + aY * stride + ptrdiff_t(aX) * 4;
+  }
+
+  bool Opaque(int32_t aX, int32_t aY) const {
+    return layout.a < 0 || At(aX, aY)[layout.a] == 0xFF;
+  }
+
+  // The pixel without its lowest bits; outside the image, transparent black.
+  uint32_t Coarse(int32_t aX, int32_t aY) const {
+    if (aX < 0 || aY < 0 || aX >= width || aY >= height) {
+      return 0;
+    }
+    const uint8_t* p = At(aX, aY);
+    const uint32_t alpha = layout.a < 0 ? 0xFF : p[layout.a];
+    return uint32_t(p[layout.r] >> 1) << 24 | uint32_t(p[layout.g] >> 1) << 16 |
+           uint32_t(p[layout.b] >> 1) << 8 | alpha >> 1;
+  }
+};
+
+// The lowest bits of red, green and blue (bits 0, 1, 2) the pixel at
+// (aX, aY) reads back with, or -1 when it reads back as drawn.
+inline int32_t Bits(const Image& aImage, int32_t aX, int32_t aY,
+                    uint64_t aSeed) {
+  if (!aImage.Opaque(aX, aY)) {
+    return -1;
+  }
+  const uint32_t centre = aImage.Coarse(aX, aY);
+  if (centre == aImage.Coarse(aX - 1, aY) ||
+      centre == aImage.Coarse(aX + 1, aY) ||
+      centre == aImage.Coarse(aX, aY - 1) ||
+      centre == aImage.Coarse(aX, aY + 1)) {
+    return -1;
+  }
+  uint64_t hash = aSeed;
+  for (int32_t dy = -1; dy <= 1; ++dy) {
+    for (int32_t dx = -1; dx <= 1; ++dx) {
+      hash = Mix(hash ^ aImage.Coarse(aX + dx, aY + dy));
+    }
+  }
+  return int32_t(hash >> 61);
+}
+
+inline void SetBits(uint8_t* aPixel, const Layout& aLayout, int32_t aBits) {
+  aPixel[aLayout.r] = (aPixel[aLayout.r] & 0xFE) | (aBits & 1);
+  aPixel[aLayout.g] = (aPixel[aLayout.g] & 0xFE) | ((aBits >> 1) & 1);
+  aPixel[aLayout.b] = (aPixel[aLayout.b] & 0xFE) | ((aBits >> 2) & 1);
+}
+
+// Applies the noise to a whole image in place. Safe in place because a pixel's
+// key ignores the bits that change.
+inline void Apply(uint8_t* aData, ptrdiff_t aStride, int32_t aWidth,
+                  int32_t aHeight, const Layout& aLayout) {
+  const uint64_t seed = Seed();
+  if (!seed || !aData) {
+    return;
+  }
+  const Image image{aData, aStride, aWidth, aHeight, aLayout};
+  for (int32_t y = 0; y < aHeight; ++y) {
+    for (int32_t x = 0; x < aWidth; ++x) {
+      const int32_t bits = Bits(image, x, y, seed);
+      if (bits >= 0) {
+        SetBits(aData + y * aStride + ptrdiff_t(x) * 4, aLayout, bits);
+      }
+    }
+  }
+}
+
+// Applies the noise to a copy of the rectangle at (aX, aY) of aSource, whose
+// pixels outside the rectangle still decide the keys at its edges.
+inline void ApplyToCopy(const Image& aSource, int32_t aX, int32_t aY,
+                        uint8_t* aDest, ptrdiff_t aDestStride, int32_t aWidth,
+                        int32_t aHeight, const Layout& aDestLayout) {
+  const uint64_t seed = Seed();
+  if (!seed || !aDest) {
+    return;
+  }
+  for (int32_t y = 0; y < aHeight; ++y) {
+    for (int32_t x = 0; x < aWidth; ++x) {
+      const int32_t bits = Bits(aSource, aX + x, aY + y, seed);
+      if (bits >= 0) {
+        SetBits(aDest + y * aDestStride + ptrdiff_t(x) * 4, aDestLayout, bits);
+      }
+    }
+  }
+}
+
+}  // namespace mozilla::readback_noise
+
+#endif  // DOM_CANVAS_ALIASMODEREADBACKNOISE_H_
