+#ifndef DOM_CANVAS_ALIASMODEREADBACKNOISE_H_
+#define DOM_CANVAS_ALIASMODEREADBACKNOISE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+#include "MaskConfig.hpp"
+
+// Per-profile readback noise for canvas and WebGL pixels (aliasmode:canvasSeed).
+//
+// Profiles on one machine share a GPU, a rasterizer and fonts, so without this
+// they read back identical pixels. With a seed, each colour channel of an
+// eligible pixel falls in a band of four values whose position is the
+// profile's own, and reads back as the band member drawn from the seed and
+// the pixel's 3x3 neighbourhood of bands:
+//
+// - The answer depends on content only, never on position or on the call, so
+//   every read path, every sub-rectangle and every pixel-aligned copy of the
+//   same pixels agrees, and a profile reads the same bytes on every launch.
+// - Reading, writing back and reading again changes nothing: a value never
+//   leaves its band, and the bands are the key.
+// - A channel moves by at most 3, but no fixed rounding of the values hides
+//   the move: the bands straddle the boundaries of every power-of-two bucket.
+// - Only pixels at least half opaque that differ from all four direct
+//   neighbours, or sit among three or more values, are eligible: anti-aliased
+//   edges, lines, blends and gradients, where rasterizers and GPUs differ
+//   between machines. Flat fills, the edges and corners of flat shapes,
+//   cleared pixels and images under 16 pixels on a side read back as drawn.
+namespace mozilla::readback_noise {
+
+inline uint64_t Mix(uint64_t aValue) {
+  aValue ^= aValue >> 30;
+  aValue *= 0xbf58476d1ce4e5b9ull;
+  aValue ^= aValue >> 27;
+  aValue *= 0x94d049bb133111ebull;
+  return aValue ^ (aValue >> 31);
+}
+
+// The profile's seed; zero leaves every readback stock.
+inline uint64_t Seed() {
+  static const uint64_t seed = [] {
+    const uint64_t value =
+        MaskConfig::GetUint32("aliasmode:canvasSeed").value_or(0);
+    return value ? Mix(value ^ 0x9e3779b97f4a7c15ull) : 0;
+  }();
+  return seed;
+}
+
+// Where the profile's bands of red, green and blue start: 1, 2 or 3 past a
+// multiple of four, never 0, so no band lines up with a power-of-two bucket.
+inline uint32_t BandOffset(int aChannel) {
+  return 1 + uint32_t((Seed() >> (8 * aChannel)) % 3);
+}
+
+// The band of a channel value: 0 for the values below the first band start.
+inline uint32_t Band(uint32_t aValue, uint32_t aOffset) {
+  return (aValue + 4 - aOffset) >> 2;
+}
+
+// Images smaller than this on either side read back as drawn: tiny probe
+// canvases hold values known per engine.
+inline constexpr int32_t kMinSide = 16;
+
+inline bool Exempt(int32_t aWidth, int32_t aHeight) {
+  return aWidth < kMinSide || aHeight < kMinSide;
+}
+
+// Byte offsets of the channels in a 4-byte pixel. A negative alpha offset
+// means the format has no alpha, and every pixel is opaque.
+struct Layout {
+  int8_t r, g, b, a;
+};
+inline constexpr Layout kBGRA{2, 1, 0, 3};
+inline constexpr Layout kBGRX{2, 1, 0, -1};
+inline constexpr Layout kRGBA{0, 1, 2, 3};
+
+inline uint32_t Alpha(const uint8_t* aPixel, const Layout& aLayout) {
+  return aLayout.a < 0 ? 0xFF : aPixel[aLayout.a];
+}
+
+// Pixels as the page sees them: `origin` is the top-left pixel and rows are
+// `stride` bytes apart (negative for the bottom-up rows of a GL readback).
+struct Image {
+  const uint8_t* origin;
+  ptrdiff_t stride;
+  int32_t width;
+  int32_t height;
+  Layout layout;
+  uint32_t offsets[3] = {BandOffset(0), BandOffset(1), BandOffset(2)};
+
+  const uint8_t* At(int32_t aX, int32_t aY) const {
+    return origin + aY * stride + ptrdiff_t(aX) * 4;
+  }
+
+  // The bands of the pixel and its alpha; outside the image, the value of a
+  // cleared pixel.
+  uint32_t Coarse(int32_t aX, int32_t aY) const {
+    if (aX < 0 || aY < 0 || aX >= width || aY >= height) {
+      return 0;
+    }
+    const uint8_t* p = At(aX, aY);
+    return Band(p[layout.r], offsets[0]) << 24 |
+           Band(p[layout.g], offsets[1]) << 16 |
+           Band(p[layout.b], offsets[2]) << 8 | Alpha(p, layout);
+  }
+};
+
+// Two bits each for red, green and blue (bits 0-1, 2-3, 4-5) for the pixel at
+// column aI of aRow, between aAbove and aBelow, or -1 to keep it as drawn.
+inline int32_t Bits(const uint32_t* aAbove, const uint32_t* aRow,
+                    const uint32_t* aBelow, size_t aI, uint64_t aSeed) {
+  const uint32_t around[9] = {aAbove[aI - 1], aAbove[aI], aAbove[aI + 1],
+                              aRow[aI - 1],   aRow[aI],   aRow[aI + 1],
+                              aBelow[aI - 1], aBelow[aI], aBelow[aI + 1]};
+  const uint32_t centre = around[4];
+  if ((centre & 0xFF) < 0x80) {
+    return -1;
+  }
+  // A pixel unlike its four neighbours, or among three or more values: an
+  // anti-aliased edge, a line, a blend or a gradient. Edges and corners of
+  // flat shapes hold two values and stay exact.
+  bool varied = centre != around[1] && centre != around[3] &&
+                centre != around[5] && centre != around[7];
+  uint32_t other = centre;
+  for (size_t i = 0; i < 9 && !varied; ++i) {
+    if (around[i] == centre || around[i] == other) {
+      continue;
+    }
+    if (other == centre) {
+      other = around[i];
+    } else {
+      varied = true;
+    }
+  }
+  if (!varied) {
+    return -1;
+  }
+  const uint64_t hash =
+      aSeed + around[0] * 0xc4ceb9fe1a85ec53ull +
+      around[1] * 0xc2b2ae3d27d4eb4full + around[2] * 0x87c37b91114253d5ull +
+      around[3] * 0x165667b19e3779f9ull + around[4] * 0x9e3779b97f4a7c15ull +
+      around[5] * 0xd6e8feb86659fd93ull + around[6] * 0x4cf5ad432745937full +
+      around[7] * 0xff51afd7ed558ccdull + around[8] * 0x94d049bb133111ebull;
+  return int32_t(Mix(hash) >> 58);
+}
+
+// Moves one channel to the member of its band that aPick (0-3) selects. A
+// premultiplied colour never exceeds its alpha; one that already does is kept.
+inline uint8_t Step(uint32_t aValue, uint32_t aOffset, uint32_t aPick,
+                    uint32_t aCap) {
+  if (aValue > aCap) {
+    return uint8_t(aValue);
+  }
+  const int32_t start =
+      int32_t(Band(aValue, aOffset)) * 4 - 4 + int32_t(aOffset);
+  const int32_t low = start < 0 ? 0 : start;
+  const int32_t high = start + 3 > int32_t(aCap) ? int32_t(aCap) : start + 3;
+  return uint8_t(low + int32_t(aPick % uint32_t(high - low + 1)));
+}
+
+inline void SetBits(uint8_t* aPixel, const Layout& aLayout,
+                    const uint32_t* aOffsets, int32_t aBits,
+                    bool aPremultiplied) {
+  const uint32_t cap = aPremultiplied ? Alpha(aPixel, aLayout) : 0xFF;
+  const int8_t channels[3] = {aLayout.r, aLayout.g, aLayout.b};
+  for (int c = 0; c < 3; ++c) {
+    uint8_t& value = aPixel[channels[c]];
+    value = Step(value, aOffsets[c], uint32_t(aBits >> (2 * c)) & 3, cap);
+  }
+}
+
+// Applies the noise of the aWidth x aHeight rectangle at (aX, aY) of aSource
+// to aDest, a copy of that rectangle whose top-left pixel is at aDest and
+// whose rows are aDestStride bytes apart. Pixels outside the rectangle still
+// decide the keys at its edges. aDest may be aSource's own memory: a key
+// ignores the values a step can reach.
+inline void ApplyToCopy(const Image& aSource, int32_t aX, int32_t aY,
+                        uint8_t* aDest, ptrdiff_t aDestStride, int32_t aWidth,
+                        int32_t aHeight, const Layout& aDestLayout,
+                        bool aPremultiplied) {
+  const uint64_t seed = Seed();
+  if (!seed || !aDest || aWidth <= 0 || aHeight <= 0) {
+    return;
+  }
+  // The coarse values of three rows, one pixel wider on each side.
+  const size_t span = size_t(aWidth) + 2;
+  std::vector<uint32_t> rows(span * 3);
+  const auto row = [&](int32_t aRowY) {
+    return rows.data() + size_t((aRowY - aY + 1) % 3) * span;
+  };
+  const auto fill = [&](int32_t aRowY) {
+    uint32_t* out = row(aRowY);
+    for (size_t i = 0; i < span; ++i) {
+      out[i] = aSource.Coarse(aX - 1 + int32_t(i), aRowY);
+    }
+  };
+  fill(aY - 1);
+  fill(aY);
+  for (int32_t y = aY; y < aY + aHeight; ++y) {
+    fill(y + 1);
+    const uint32_t* above = row(y - 1);
+    const uint32_t* current = row(y);
+    const uint32_t* below = row(y + 1);
+    uint8_t* dest = aDest + (y - aY) * aDestStride;
+    for (int32_t x = 0; x < aWidth; ++x) {
+      const int32_t bits = Bits(above, current, below, size_t(x) + 1, seed);
+      if (bits >= 0) {
+        SetBits(dest + ptrdiff_t(x) * 4, aDestLayout, aSource.offsets, bits,
+                aPremultiplied);
+      }
+    }
+  }
+}
+
+// Applies the noise to a whole image in place.
+inline void Apply(uint8_t* aData, ptrdiff_t aStride, int32_t aWidth,
+                  int32_t aHeight, const Layout& aLayout, bool aPremultiplied) {
+  if (Exempt(aWidth, aHeight)) {
+    return;
+  }
+  ApplyToCopy(Image{aData, aStride, aWidth, aHeight, aLayout}, 0, 0, aData,
+              aStride, aWidth, aHeight, aLayout, aPremultiplied);
+}
+
+}  // namespace mozilla::readback_noise
+
+#endif  // DOM_CANVAS_ALIASMODEREADBACKNOISE_H_
