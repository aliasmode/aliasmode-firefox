 void PeerConnectionImpl::MaybeFabricateSrflxCandidate() {
   // Only what a real gather could have produced and did not: host candidates
   // when none reached the page, and a srflx only when the page configured an
-  // ICE server. `new RTCPeerConnection()` with no iceServers gathers host
-  // candidates alone in stock Firefox; a srflx there (plus a second host set
-  // after end-of-candidates) was a direct tell.
+  // ICE server that could report the public address. `new
+  // RTCPeerConnection()` with no iceServers gathers host candidates alone in
+  // stock Firefox; a srflx there (plus a second host set after
+  // end-of-candidates) was a direct tell, and so was one from a server on
+  // loopback.
   const bool wantHosts = !mSurfacedHostCandidate;
-  const bool wantSrflx =
-      !mSurfacedPublicCandidate && !mJsConfiguration.mIceServers.IsEmpty();
+  const bool wantSrflx = !mSurfacedPublicCandidate &&
+                         ConfiguresPublicIceServer(mJsConfiguration);
   if (!ShouldSpoofCandidateIP() || (!wantHosts && !wantSrflx)) {
     return;
   }
