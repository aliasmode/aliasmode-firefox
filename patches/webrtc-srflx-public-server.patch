+// Whether the page configured a STUN or TURN server that could answer with the
+// public address: a host name outside the special-use domains, or an address
+// outside the loopback, private, link-local, shared and unspecified ranges. The
+// name is not resolved here: behind the proxy stock gathers no STUN at all, and
+// a lookup from this machine would reach its own resolver around the proxy.
+static bool ConfiguresPublicIceServer(
+    const RTCConfigurationInternal& aConfig) {
+  static const nsLiteralCString kSpecialUse[] = {
+      ".localhost"_ns, ".local"_ns, ".invalid"_ns,   ".test"_ns, ".example"_ns,
+      ".internal"_ns,  ".onion"_ns, ".home.arpa"_ns, ".alt"_ns};
+  for (const auto& server : aConfig.mIceServers) {
+    for (const auto& url : server.mUrls) {
+      auto parsed =
+          IceServerParser::ParseStunTurnUri(NS_ConvertUTF16toUTF8(url));
+      if (parsed.isErr()) {
+        parsed.unwrapErr().SuppressException();
+        continue;
+      }
+      nsAutoCString host(parsed.inspect().mHost);
+      if (StringBeginsWith(host, "["_ns) && StringEndsWith(host, "]"_ns)) {
+        host = Substring(host, 1, host.Length() - 2);
+      }
+      net::NetAddr addr;
+      if (NS_SUCCEEDED(addr.InitFromString(host))) {
+        if (!addr.IsIPAddrAny() && !addr.IsLoopbackAddr() &&
+            !addr.IsIPAddrLocal() && !addr.IsIPAddrShared()) {
+          return true;
+        }
+        continue;
+      }
+      ToLowerCase(host);
+      if (host.FindChar('.') < 0) {
+        continue;
+      }
+      const nsAutoCString dotted("."_ns + host);
+      bool special = false;
+      for (const auto& suffix : kSpecialUse) {
+        special |= StringEndsWith(dotted, suffix);
+      }
+      if (!special) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
