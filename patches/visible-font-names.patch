 /* static */
+bool gfxPlatformFontList::HidesDotFamilyName(
+    FontVisibilityProvider* aFontVisibilityProvider,
+    const nsACString& aLowercaseFamily) {
+#ifdef XP_MACOSX
+  // Core Text already leaves them out, and the system font is looked up by
+  // its own path.
+  return false;
+#else
+  return aFontVisibilityProvider && !aFontVisibilityProvider->IsChrome() &&
+         StringBeginsWith(aLowercaseFamily, "."_ns);
+#endif
+}
