        // will fit without requiring separate allocation
        // for charToGlyphArray
 
+// The font's own identity, the same for the same font in any folder, process
+// or load: its PostScript name (else its full name, else its 'head' table).
+// The entry's name is not: on Linux it is the font file's path, and a
+// downloaded font on Windows and macOS gets a new random name on every load.
+/* static */
+uint32_t gfxHarfBuzzShaper::FontIdentityHash(gfxFontEntry* aEntry) {
+  nsAutoCString name;
+  {
+    gfxFontEntry::AutoTable nameTable(aEntry,
+                                      TRUETYPE_TAG('n', 'a', 'm', 'e'));
+    if (nameTable) {
+      if (NS_FAILED(gfxFontUtils::ReadCanonicalName(
+              nameTable, gfxFontUtils::NAME_ID_POSTSCRIPT, name)) ||
+          name.IsEmpty()) {
+        (void)gfxFontUtils::ReadCanonicalName(
+            nameTable, gfxFontUtils::NAME_ID_FULL, name);
+      }
+    }
+  }
+  if (!name.IsEmpty()) {
+    return mozilla::HashString(name.get(), name.Length());
+  }
+  gfxFontEntry::AutoTable headTable(aEntry, TRUETYPE_TAG('h', 'e', 'a', 'd'));
+  uint32_t len = 0;
+  const char* data =
+      headTable ? hb_blob_get_data(headTable, &len) : nullptr;
+  if (data && len) {
+    return mozilla::HashBytes(data, len);
+  }
+  const nsCString family = aEntry->FamilyName();
+  return mozilla::HashString(family.get(), family.Length());
+}
+
+int32_t gfxHarfBuzzShaper::AdvanceNoise(hb_position_t aAdvance) const {
+  if (!mAdvanceSalt || aAdvance <= 0) {
+    return 0;
+  }
+  return int32_t(mozilla::HashGeneric(mAdvanceSalt, uint32_t(aAdvance)) >> 31);
+}
