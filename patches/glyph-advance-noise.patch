+  // Profiles on one machine share their fonts, so without this they share
+  // every text width. The salt depends on the font, not its size, so a glyph
+  // moves the same way in every document, canvas and worker of the profile.
+  static const uint32_t sTextSeed =
+      MaskConfig::GetUint32("aliasmode:textSeed").value_or(0);
+  if (sTextSeed) {
+    mAdvanceSalt =
