        // will fit without requiring separate allocation
        // for charToGlyphArray
 
+int32_t gfxHarfBuzzShaper::AdvanceNoise(hb_position_t aAdvance) const {
+  if (!mAdvanceSalt || aAdvance <= 0) {
+    return 0;
+  }
+  return int32_t(mozilla::HashGeneric(mAdvanceSalt, uint32_t(aAdvance)) >> 31);
+}
