        // will fit without requiring separate allocation
        // for charToGlyphArray
 
+int32_t gfxHarfBuzzShaper::AdvanceNoise(uint32_t aGlyph,
+                                        hb_position_t aAdvance) const {
+  return mAdvanceSalt && aAdvance > 0
+             ? int32_t(mozilla::HashGeneric(mAdvanceSalt, aGlyph) >> 31)
+             : 0;
+}
