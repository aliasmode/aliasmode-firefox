+/* static */
+already_AddRefed<nsIFile> gfxPlatformFontList::FontPackDir() {
+  // The engine package carries no fonts of other OSes; the app keeps them in
+  // its own data folder, which survives app updates, and passes the folder of
+  // the identity's OS here.
+  auto path = MaskConfig::GetString("aliasmode:fontsDir");
+  if (!path || path->empty()) {
+    return nullptr;
+  }
+  nsCOMPtr<nsIFile> dir;
+  bool isDir = false;
+  if (NS_FAILED(NS_NewUTF8LocalFile(nsDependentCString(path->c_str()),
+                                    getter_AddRefs(dir))) ||
+      NS_FAILED(dir->IsDirectory(&isDir)) || !isDir) {
+    return nullptr;
+  }
+  return dir.forget();
+}
