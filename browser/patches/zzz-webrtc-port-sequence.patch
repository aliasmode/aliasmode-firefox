diff --git a/dom/media/webrtc/transport/nr_socket_prsock.cpp b/dom/media/webrtc/transport/nr_socket_prsock.cpp
--- a/dom/media/webrtc/transport/nr_socket_prsock.cpp
+++ b/dom/media/webrtc/transport/nr_socket_prsock.cpp
@@ -1817,6 +1817,7 @@ int NrSocketBase::CreateSocket(
   int r, _status;
   uint16_t port = 0;
   std::optional<std::pair<uint16_t, uint16_t>> ports;
+  bool sequential = false;
   // Camoufox: behind a proxy, stock Firefox refuses UDP outright, which leaves
   // a page with no host candidate and no connection even to a peer on this
   // machine. Make the socket, but let nothing it sends leave this host other
@@ -1836,7 +1837,11 @@ int NrSocketBase::CreateSocket(
   if (addr->protocol == IPPROTO_UDP &&
       !nr_transport_addr_get_port(addr, &port) && port == 0) {
     ports = MaskConfig::SpoofedEphemeralPorts();
-    if (ports == kHostEphemeralPorts) {
+    // AliasMode: and in sequence where its kernel hands them out that way
+    // (Windows), so a Windows identity on macOS shows Windows ports too.
+    sequential = MaskConfig::SequentialEphemeralPorts();
+    if (ports == kHostEphemeralPorts &&
+        sequential == MaskConfig::HostSequentialEphemeralPorts()) {
       ports.reset();
     }
   }
@@ -1846,10 +1851,8 @@ int NrSocketBase::CreateSocket(
     nr_transport_addr bindAddr;
     nr_transport_addr_copy(&bindAddr, addr);
     if (ports) {
-      uint32_t span = static_cast<uint32_t>(ports->second - ports->first) + 1u;
       nr_transport_addr_set_port(
-          &bindAddr, ports->first + static_cast<int>(
-                                        mozilla::RandomUint64OrDie() % span));
+          &bindAddr, MaskConfig::NextEphemeralPort(*ports, sequential));
       nr_transport_addr_fmt_addr_string(&bindAddr);
     }
 
