AliasMode: a Windows identity binds its WebRTC UDP ports in sequence, as the
Windows kernel hands out ephemeral ports, also on a macOS or Linux host.
Needs MaskConfig::NextEphemeralPort (additions/camoucfg/MaskConfig.hpp).

diff --git a/dom/media/webrtc/jsapi/PeerConnectionImpl.cpp b/dom/media/webrtc/jsapi/PeerConnectionImpl.cpp
--- a/dom/media/webrtc/jsapi/PeerConnectionImpl.cpp
+++ b/dom/media/webrtc/jsapi/PeerConnectionImpl.cpp
@@ -3695,12 +3695,12 @@ nsresult PeerConnectionImpl::SanitizeSDPForIPLeak(std::string& sdp) {
 // ephemeral range of the OS the context presents; Linux's when no platform is
 // configured.
 static uint16_t RandomEphemeralPort(uint32_t aUserContextId) {
-  const auto [lo, hi] =
-      MaskConfig::SpoofedEphemeralPorts(
-          dom::NavigatorManager::GetSpoofedOS(aUserContextId))
-          .value_or(std::pair<uint16_t, uint16_t>{32768, 60999});
-  uint32_t span = static_cast<uint32_t>(hi - lo) + 1u;
-  return static_cast<uint16_t>(lo + (mozilla::RandomUint64OrDie() % span));
+  const auto os = dom::NavigatorManager::GetSpoofedOS(aUserContextId);
+  // AliasMode: in sequence where the OS's kernel hands ports out that way.
+  return MaskConfig::NextEphemeralPort(
+      MaskConfig::SpoofedEphemeralPorts(os).value_or(
+          std::pair<uint16_t, uint16_t>{32768, 60999}),
+      MaskConfig::SequentialEphemeralPorts(os));
 }
 
