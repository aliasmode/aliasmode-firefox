+void PeerConnectionImpl::FakeIceGather() {
+  const std::string transportId = mFakeIceTransportId;
+  std::string ufrag;
+  mJsepSession->ForEachTransceiver([&](const JsepTransceiver& aTransceiver) {
+    if (ufrag.empty() &&
+        aTransceiver.mTransport.mTransportId == transportId) {
+      ufrag = aTransceiver.mTransport.mLocalUfrag;
+    }
+  });
+  auto ipv4 = SpoofIP(false);
+  auto ipv6 = SpoofIP(true);
+  const std::string publicIp = ipv4 ? *ipv4 : (ipv6 ? *ipv6 : std::string());
+  std::string uuid;
+  if (ufrag.empty() || publicIp.empty() || !mUuidGen ||
+      !mUuidGen->Generate(&uuid)) {
+    return;
+  }
+  // PCUuidGenerator yields "{uuid}"; the mDNS name is the bare uuid.
+  if (!uuid.empty() && uuid.front() == '{') uuid.erase(0, 1);
+  if (!uuid.empty() && uuid.back() == '}') uuid.pop_back();
+  const std::string mdnsHost = uuid + ".local";
+
+  const bool relayOnly = RelayOnly();
+  const bool overlay = mFakeIceOverlay;
+  std::vector<FakeIceServer> servers =
+      PlanFakeIceServers(mJsConfiguration, ProxyRoundTripMs());
+  bool anyTurn = false;
+  for (const auto& server : servers) {
+    anyTurn |= server.mTurn;
+  }
+
+  // nICEr numbers candidates by kind and base, and server-derived ones also
+  // by server: host UDP, then per STUN server a srflx, per TURN server a
+  // srflx and a relay, then host TCP.
+  enum Kind { HostUdp, Srflx, Relay, HostTcp };
+  std::vector<std::pair<Kind, std::string>> foundations;
+  auto foundation = [&](Kind aKind, const std::string& aKey) {
+    for (size_t i = 0; i < foundations.size(); ++i) {
+      if (foundations[i].first == aKind && foundations[i].second == aKey) {
+        return std::to_string(i);
+      }
+    }
+    foundations.emplace_back(aKind, aKey);
+    return std::to_string(foundations.size() - 1);
+  };
+  const std::string hostUdpFoundation = foundation(HostUdp, "");
+  std::string srflxFoundation;
+  Maybe<uint32_t> srflxAt;
+  uint32_t endAt = 0;
+  for (const auto& server : servers) {
+    const std::string f = foundation(Srflx, server.mKey);
+    if (server.mTurn) {
+      foundation(Relay, server.mKey);
+    }
+    if (server.mOutcome == FakeServerOutcome::Answers && !relayOnly &&
+        (!srflxAt || server.mAtMs < *srflxAt)) {
+      srflxAt = Some(server.mAtMs);
+      srflxFoundation = f;
+    }
+    endAt = std::max(endAt, server.mAtMs);
+  }
+  const std::string hostTcpFoundation = foundation(HostTcp, "");
+
+  const auto os = dom::NavigatorManager::GetSpoofedOS(
+      dom::RoverfoxStorageManager::UserContextId(mWindow.get()));
+  const uint16_t port = MaskConfig::NextEphemeralPort(
+      MaskConfig::SpoofedEphemeralPorts(os).value_or(
+          std::pair<uint16_t, uint16_t>{32768, 60999}),
+      MaskConfig::SequentialEphemeralPorts(os), 2);
+  // nICEr binds the active TCP candidate itself, on a random port of
+  // 49152-65535; the candidate line says 9, getStats() the bound port.
+  const uint16_t tcpPort =
+      static_cast<uint16_t>(49152 + mozilla::RandomUint64OrDie() % 16384);
+  const nsString ufrag16 = NS_ConvertUTF8toUTF16(ufrag.c_str());
+  auto statsId = [] {
+    char id[9];
+    SprintfLiteral(id, "%x",
+                   static_cast<uint32_t>(mozilla::RandomUint64OrDie()));
+    return NS_ConvertASCIItoUTF16(id);
+  };
+
+  RefPtr<PeerConnectionImpl> self(this);
+  auto emitError = [self](const std::string& aUrl) {
+    IceCandidateErrorInfo info;
+    info.mUrl = aUrl;
+    info.mErrorCode = 701;
+    self->mFakeIceDriving = true;
+    self->OnCandidateError(info);
+    self->mFakeIceDriving = false;
+  };
+  const TimeStamp start = TimeStamp::Now();
+  auto later = [self, start](uint32_t aDelayMs, std::function<void()>&& aStep) {
+    FakeIceRunAt(start + TimeDuration::FromMilliseconds(aDelayMs),
+                 [self, step = std::move(aStep)]() {
+                   if (!self->IsClosed()) {
+                     step();
+                   }
+                 });
+  };
+
+  // An ICMP error for a server on this machine arrives before gathering shows.
+  for (const auto& server : servers) {
+    if (server.mOutcome == FakeServerOutcome::FailsAtOnce) {
+      emitError(server.mUrl);
+    }
+  }
