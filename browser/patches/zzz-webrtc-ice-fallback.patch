+void PeerConnectionImpl::StartFakeIce(const std::string& aTransportId) {
+  mFakeIceTransportId = aTransportId;
+  if (mFakeIceOverlay) {
+    FakeIceGather();
+    return;
+  }
+  mFakeIce = true;
+  // Its own host candidates stand in for the ones Camoufox makes up.
+  mSurfacedHostCandidate = true;
+  FakeIceGather();
+  if (mIceChecksStarted) {
+    StartFakeIceChecks();
+  }
+}
