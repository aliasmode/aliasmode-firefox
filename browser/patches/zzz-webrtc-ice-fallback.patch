+void PeerConnectionImpl::StartFakeIce() {
+  // Its own host candidates stand in for the ones Camoufox makes up, and
+  // for the real agent's.
+  mSurfacedHostCandidate = true;
+  if (mFakeIceOverlay) {
+    FakeIceGather();
+    return;
+  }
+  mFakeIce = true;
+  FakeIceGather();
+  if (mIceChecksStarted) {
+    StartFakeIceChecks();
+  }
+}
+
+void PeerConnectionImpl::FakeIceGather() {
+  auto ipv4 = SpoofIP(false);
+  auto ipv6 = SpoofIP(true);
+  const std::string publicIp = ipv4 ? *ipv4 : (ipv6 ? *ipv6 : std::string());
+  std::string uuid;
+  if (mFakeIceTransports.empty() || publicIp.empty() || !mUuidGen ||
+      !mUuidGen->Generate(&uuid)) {
+    return;
+  }
+  // PCUuidGenerator yields "{uuid}"; the mDNS name is the bare uuid.
+  if (!uuid.empty() && uuid.front() == '{') uuid.erase(0, 1);
+  if (!uuid.empty() && uuid.back() == '}') uuid.pop_back();
+  const std::string mdnsHost = uuid + ".local";
+
+  const bool relayOnly = RelayOnly();
+  const bool overlay = mFakeIceOverlay;
+  const std::vector<FakeIceServer> servers =
+      PlanFakeIceServers(mJsConfiguration, ProxyRoundTripMs());
+
+  // nICEr numbers candidates by kind and base, and server-derived ones also
+  // by server, the same in every transport and component: host UDP, then per
+  // STUN server a srflx, per TURN server a srflx and a relay, then host TCP.
+  enum Kind { HostUdp, Srflx, Relay, HostTcp };
+  std::vector<std::pair<Kind, std::string>> foundations;
+  auto foundation = [&](Kind aKind, const std::string& aKey) {
+    for (size_t i = 0; i < foundations.size(); ++i) {
+      if (foundations[i].first == aKind && foundations[i].second == aKey) {
+        return std::to_string(i);
+      }
+    }
+    foundations.emplace_back(aKind, aKey);
+    return std::to_string(foundations.size() - 1);
+  };
+  const std::string hostUdpFoundation = foundation(HostUdp, "");
+  std::vector<std::string> srflxFoundations;
+  for (const auto& server : servers) {
+    srflxFoundations.push_back(foundation(Srflx, server.mKey));
+    if (server.mTurn) {
+      foundation(Relay, server.mKey);
+    }
+  }
+  const std::string hostTcpFoundation = foundation(HostTcp, "");
+
+  // Every component's request to every server, in the order nICEr creates
+  // them: by transport, then component, then server.
+  struct Request {
+    size_t mTransport;
+    uint32_t mComponent;
+    size_t mServer;
+    uint32_t mAtMs = 0;  // its answer, error or timeout
+  };
+  std::vector<Request> requests;
+  for (size_t t = 0; t < mFakeIceTransports.size(); ++t) {
+    for (uint32_t c = 1; c <= mFakeIceTransports[t].mComponents; ++c) {
+      for (size_t s = 0; s < servers.size(); ++s) {
+        requests.push_back({t, c, s});
+      }
+    }
+  }
+  // nICEr starts a request kFakeIceTaMs after the one before, counted from
+  // when it is set up: at once for an address, after the lookup for a name.
+  // One on this machine, or a name that does not resolve, never starts.
+  {
+    std::vector<size_t> order;
+    for (size_t i = 0; i < requests.size(); ++i) {
+      const auto& server = servers[requests[i].mServer];
+      if (server.mOutcome == FakeServerOutcome::FailsAtOnce) {
+        continue;
+      }
+      if (server.mOutcome == FakeServerOutcome::FailsLookup) {
+        requests[i].mAtMs = server.mLookupMs;
+        continue;
+      }
+      order.push_back(i);
+    }
+    std::stable_sort(order.begin(), order.end(), [&](size_t a, size_t b) {
+      return servers[requests[a].mServer].mLookupMs <
+             servers[requests[b].mServer].mLookupMs;
+    });
+    uint32_t delay = 0;
+    for (size_t i : order) {
+      const auto& server = servers[requests[i].mServer];
+      requests[i].mAtMs = server.mLookupMs + delay + server.mReplyMs;
+      delay += kFakeIceTaMs;
+    }
+  }
+
+  const auto os = dom::NavigatorManager::GetSpoofedOS(
+      dom::RoverfoxStorageManager::UserContextId(mWindow.get()));
+  const auto portRange = MaskConfig::SpoofedEphemeralPorts(os).value_or(
+      std::pair<uint16_t, uint16_t>{32768, 60999});
+  const bool sequentialPorts = MaskConfig::SequentialEphemeralPorts(os);
+  auto statsId = [] {
+    char id[9];
+    SprintfLiteral(id, "%x",
+                   static_cast<uint32_t>(mozilla::RandomUint64OrDie()));
+    return NS_ConvertASCIItoUTF16(id);
+  };
+
+  RefPtr<PeerConnectionImpl> self(this);
+  const TimeStamp start = TimeStamp::Now();
+  auto later = [self, start](uint32_t aDelayMs, std::function<void()>&& aStep) {
+    FakeIceRunAt(start + TimeDuration::FromMilliseconds(aDelayMs),
+                 [self, step = std::move(aStep)]() {
+                   if (!self->IsClosed()) {
+                     step();
+                   }
+                 });
+  };
+  auto emitError = [self](const std::string& aUrl) {
+    IceCandidateErrorInfo info;
+    info.mUrl = aUrl;
+    info.mErrorCode = 701;
+    self->mFakeIceDriving = true;
+    self->OnCandidateError(info);
+    self->mFakeIceDriving = false;
+  };
+
+  // An ICMP error for a server on this machine arrives before gathering shows,
+  // one per component.
+  for (const auto& request : requests) {
+    if (servers[request.mServer].mOutcome == FakeServerOutcome::FailsAtOnce) {
+      emitError(servers[request.mServer].mUrl);
+    }
+  }
+  // With relay only and no TURN server there is nothing to gather.
+  const bool anyTurn = std::any_of(servers.begin(), servers.end(),
+                                   [](const auto& aServer) { return aServer.mTurn; });
+  if (!overlay && relayOnly && !anyTurn) {
+    return;
+  }
+  // In the overlay the real agent's own report of this comes later, and then
+  // changes nothing.
+  for (const auto& transport : mFakeIceTransports) {
+    DriveFakeGathering(transport.mId, dom::RTCIceGathererState::Gathering);
+  }
+
+  // What a transport's gathering ends with: end-of-candidates and complete,
+  // or in the overlay the real agent's, which waited for this.
+  auto finish = [self, overlay](size_t aTransport) {
+    auto& transport = self->mFakeIceTransports[aTransport];
+    if (overlay) {
+      self->EndFakeIceOverlay(aTransport);
+      return;
+    }
+    self->EmitFakeCandidate("", transport.mId, transport.mUfrag);
+    self->DriveFakeGathering(transport.mId,
+                             dom::RTCIceGathererState::Complete);
+  };
+
+  for (size_t t = 0; t < mFakeIceTransports.size(); ++t) {
+    auto& transport = mFakeIceTransports[t];
+    const nsString ufrag16 = NS_ConvertUTF8toUTF16(transport.mUfrag.c_str());
+    uint32_t endAt = 0;
+    for (uint32_t c = 1; c <= transport.mComponents; ++c) {
+      const uint16_t port =
+          MaskConfig::NextEphemeralPort(portRange, sequentialPorts, 2);
+      // nICEr binds the active TCP candidate itself, on a random port of
+      // 49152-65535; the candidate line says 9, getStats() the bound port.
+      const uint16_t tcpPort =
+          static_cast<uint16_t>(49152 + mozilla::RandomUint64OrDie() % 16384);
+      if (!relayOnly) {
+        const uint32_t udpPriority = kHostUdpPriority - (c - 1);
+        std::ostringstream hostUdp;
+        hostUdp << "candidate:" << hostUdpFoundation << " " << c << " UDP "
+                << udpPriority << " " << mdnsHost << " " << port << " typ host";
+        mFakeIceStats.push_back({statsId(), dom::RTCIceCandidateType::Host,
+                                 NS_ConvertASCIItoUTF16("udp"),
+                                 NS_ConvertUTF8toUTF16(mdnsHost.c_str()), port,
+                                 udpPriority,
+                                 NS_ConvertASCIItoUTF16(hostUdpFoundation.c_str()),
+                                 false, ufrag16, transport.mId, c});
+        EmitFakeCandidate(hostUdp.str(), transport.mId, transport.mUfrag);
+
+        const uint32_t tcpPriority = kHostTcpPriority - (c - 1);
+        std::ostringstream hostTcp;
+        hostTcp << "candidate:" << hostTcpFoundation << " " << c << " TCP "
+                << tcpPriority << " " << mdnsHost
+                << " 9 typ host tcptype active";
+        mFakeIceStats.push_back({statsId(), dom::RTCIceCandidateType::Host,
+                                 NS_ConvertASCIItoUTF16("tcp"),
+                                 NS_ConvertUTF8toUTF16(mdnsHost.c_str()),
+                                 tcpPort, tcpPriority,
+                                 NS_ConvertASCIItoUTF16(hostTcpFoundation.c_str()),
+                                 true, ufrag16, transport.mId, c});
+        EmitFakeCandidate(hostTcp.str(), transport.mId, transport.mUfrag);
+      }
+
+      // The first answer gives the srflx; the others name the same address.
+      const Request* srflx = nullptr;
+      for (const auto& request : requests) {
+        if (request.mTransport != t || request.mComponent != c) {
+          continue;
+        }
+        const auto& server = servers[request.mServer];
+        endAt = std::max(endAt, request.mAtMs);
+        if (server.mOutcome == FakeServerOutcome::Answers) {
+          if (!relayOnly && (!srflx || request.mAtMs < srflx->mAtMs)) {
+            srflx = &request;
+          }
+        } else if (server.mOutcome != FakeServerOutcome::FailsAtOnce) {
+          later(request.mAtMs, [emitError, url = server.mUrl]() { emitError(url); });
+        }
+      }
+      if (!srflx) {
+        continue;
+      }
+      const auto& server = servers[srflx->mServer];
+      const std::string& srflxFoundation = srflxFoundations[srflx->mServer];
+      const uint32_t priority = kSrflxPriority - 256 * server.mId - (c - 1);
+      std::ostringstream line;
+      line << "candidate:" << srflxFoundation << " " << c << " UDP " << priority
+           << " " << publicIp << " " << port << " typ srflx raddr 0.0.0.0 rport 0";
+      FakeIceCandidateStat stat{statsId(), dom::RTCIceCandidateType::Srflx,
+                                NS_ConvertASCIItoUTF16("udp"), NS_ConvertUTF8toUTF16(publicIp.c_str()),
+                                port, priority,
+                                NS_ConvertASCIItoUTF16(srflxFoundation.c_str()),
+                                false, ufrag16, transport.mId, c};
+      later(srflx->mAtMs, [self, line = line.str(), stat, publicIp, port, t, c,
+                           overlay]() {
+        auto& transport = self->mFakeIceTransports[t];
+        if (!overlay) {
+          // The srflx becomes the component's default candidate, as in
+          // stock's SDP; a component without one yet has its host's.
+          transport.mSrflxPorts[c - 1] = port;
+          const uint16_t rtp = transport.mSrflxPorts[0];
+          const uint16_t rtcp = transport.mSrflxPorts[1];
+          self->mFakeIceDriving = true;
+          self->UpdateDefaultCandidate(
+              rtp ? publicIp : "0.0.0.0", rtp ? rtp : 9,
+              transport.mComponents < 2 ? "" : (rtcp ? publicIp : "0.0.0.0"),
+              transport.mComponents < 2 ? 0 : (rtcp ? rtcp : 9), transport.mId);
+          self->mFakeIceDriving = false;
+        }
+        // getStats() lists it after its component's host UDP candidate, as
+        // nICEr does.
+        auto& stats = self->mFakeIceStats;
+        auto host = std::find_if(stats.begin(), stats.end(), [&](const auto& s) {
+          return s.mTransportId == stat.mTransportId &&
+                 s.mComponent == stat.mComponent && !s.mTcp &&
+                 s.mType == dom::RTCIceCandidateType::Host;
+        });
+        stats.insert(host == stats.end() ? stats.end() : host + 1, stat);
+        self->EmitFakeCandidate(line, transport.mId, transport.mUfrag);
+      });
+    }
+    // A transport with nothing to wait for ends before the next one
+    // gathers, as in nICEr.
+    if (endAt) {
+      later(endAt, [finish, t]() { finish(t); });
+    } else {
+      finish(t);
+    }
+  }
+}
+
+void PeerConnectionImpl::EndFakeIceOverlay(size_t aTransport) {
+  auto& transport = mFakeIceTransports[aTransport];
+  transport.mDone = true;
+  // The real agent's end of gathering waited for the servers above.
+  if (transport.mDeferredEnd) {
+    OnCandidateFound(transport.mId, transport.mDeferredEnd.extract());
+  }
+  if (transport.mDeferredComplete) {
+    transport.mDeferredComplete = false;
+    IceGatheringStateChange(transport.mId, dom::RTCIceGathererState::Complete);
+  }
+}
+
+PeerConnectionImpl::FakeIceTransport* PeerConnectionImpl::FindFakeIceTransport(
+    const std::string& aTransportId) {
+  for (auto& transport : mFakeIceTransports) {
+    if (transport.mId == aTransportId) {
+      return &transport;
+    }
+  }
+  return nullptr;
+}
+
+UniquePtr<dom::RTCStatsCollection> PeerConnectionImpl::FakeIceCandidateStats(
+    const std::set<std::string>& aTransportIds,
+    DOMHighResTimeStamp aNow) const {
+  auto stats = MakeUnique<dom::RTCStatsCollection>();
+  for (const auto& stat : mFakeIceStats) {
+    // "" asks for every transport.
+    if (!aTransportIds.count("") && !aTransportIds.count(stat.mTransportId)) {
+      continue;
+    }
+    dom::RTCIceCandidateStats cand;
+    cand.mType.Construct(dom::RTCStatsType::Local_candidate);
+    cand.mTimestamp.Construct(aNow);
+    cand.mId.Construct(stat.mId);
+    cand.mTransportId = NS_ConvertASCIItoUTF16(stat.mTransportId.c_str());
+    cand.mAddress.Construct(stat.mAddress);
+    cand.mPort.Construct(stat.mPort);
+    cand.mProtocol.Construct(stat.mProtocol);
+    cand.mCandidateType.Construct(stat.mType);
+    cand.mPriority.Construct(int32_t(stat.mPriority));
+    cand.mFoundation.Construct(stat.mFoundation);
+    cand.mUsernameFragment.Construct(stat.mUfrag);
+    if (stat.mTcp) {
+      cand.mTcpType.Construct(dom::RTCIceTcpCandidateType::Active);
+    }
+    if (!stats->mIceCandidateStats.AppendElement(cand, fallible)) {
+      mozalloc_handle_oom(0);
+    }
+  }
+  return stats;
+}
+
+void PeerConnectionImpl::StartFakeIceChecks() {
+  // A renegotiation keeps the checks of the first negotiation.
+  if (mFakeChecksStarted) {
+    return;
+  }
+  mFakeChecksStarted = true;
+  const std::string remote =
+      mJsepSession->GetRemoteDescription(kJsepDescriptionPendingOrCurrent);
+  if (remote.find("a=candidate:") != std::string::npos) {
+    DriveFakeIceState(dom::RTCIceTransportState::Checking);
+    ScheduleFakeIceFailure(kFakeIceStunTimeoutMs + FakeIceJitter(30));
+  } else {
+    ScheduleFakeIceFailure(kFakeIceGraceMs + FakeIceJitter(30));
+  }
+}
+
+void PeerConnectionImpl::FakeRemoteCandidate() {
+  if (!mFakeChecksStarted ||
+      mFakeIceState == dom::RTCIceTransportState::Failed) {
+    return;
+  }
+  if (mFakeIceState == dom::RTCIceTransportState::New) {
+    DriveFakeIceState(dom::RTCIceTransportState::Checking);
+  }
+  ScheduleFakeIceFailure(kFakeIceStunTimeoutMs + FakeIceJitter(30));
+}
+
+void PeerConnectionImpl::ScheduleFakeIceFailure(uint32_t aDelayMs) {
+  const uint32_t generation = ++mFakeFailGeneration;
+  RefPtr<PeerConnectionImpl> self(this);
+  FakeIceRunAt(
+      TimeStamp::Now() + TimeDuration::FromMilliseconds(aDelayMs),
+      [self, generation]() {
+        if (self->IsClosed() || generation != self->mFakeFailGeneration ||
+            self->mFakeIceState == dom::RTCIceTransportState::Failed) {
+          return;
+        }
+        self->DriveFakeIceState(dom::RTCIceTransportState::Failed);
+        // The transport is gone, and the data channels with it.
+        if (self->mDataConnection) {
+          self->mDataConnection->CloseAll();
+        }
+      });
+}
