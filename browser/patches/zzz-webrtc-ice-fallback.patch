+// Whether this connection gets the ICE agent behind the proxy: behind an
+// enforced proxy that relays no UDP, with the identity's address to show. It
+// depends on the context's proxy only, never on the page's configuration, so
+// every connection of a context shows the same network.
+// aliasmode:webrtcFakeIce false leaves Camoufox's own behaviour, the host
+// candidates of a machine whose UDP is blocked.
+bool PeerConnectionImpl::UsesFakeIce() const {
+  if (!mForceProxy || !mWindow || !ShouldSpoofCandidateIP() ||
+      !MaskConfig::GetOptionalBool("aliasmode:webrtcFakeIce").value_or(true)) {
+    return false;
+  }
+  return !WebRTCIPManager::ProxyRelaysUdp(
+      dom::RoverfoxStorageManager::UserContextId(mWindow.get()));
+}
+
+// A TURN server over TCP or TLS is reached through the proxy (CONNECT), so the
+// real agent gathers its relay candidate, which a call needs, and the ICE
+// agent behind the proxy adds what the UDP servers give (FakeIceGather).
+bool PeerConnectionImpl::HasTurnOverTcp() const {
+  for (const auto& server : mJsConfiguration.mIceServers) {
+    for (const auto& url : server.mUrls) {
+      auto parsed =
+          IceServerParser::ParseStunTurnUri(NS_ConvertUTF16toUTF8(url));
+      if (parsed.isErr()) {
+        parsed.unwrapErr().SuppressException();
+        continue;
+      }
+      const auto& uri = parsed.inspect();
+      if (uri.IsTurn() &&
+          (uri.IsTls() || uri.mTransport == IceServerParser::IceTransport::Tcp)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
