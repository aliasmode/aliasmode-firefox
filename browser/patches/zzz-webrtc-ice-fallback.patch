+                             NS_ConvertUTF8toUTF16(mdnsHost.c_str()), port,
+                             kHostUdpPriority,
+                             NS_ConvertASCIItoUTF16(hostUdpFoundation.c_str()),
+                             false, ufrag16});
+    EmitFakeCandidate(hostUdp.str(), ufrag);
+
+    std::ostringstream hostTcp;
+    hostTcp << "candidate:" << hostTcpFoundation << " 1 TCP "
+            << kHostTcpPriority << " " << mdnsHost
+            << " 9 typ host tcptype active";
+    mFakeIceStats.push_back({statsId(), dom::RTCIceCandidateType::Host, NS_ConvertASCIItoUTF16("tcp"),
+                             NS_ConvertUTF8toUTF16(mdnsHost.c_str()), tcpPort,
+                             kHostTcpPriority,
+                             NS_ConvertASCIItoUTF16(hostTcpFoundation.c_str()),
+                             true, ufrag16});
+    EmitFakeCandidate(hostTcp.str(), ufrag);
+  }
+
+  if (srflxAt) {
+    std::ostringstream srflx;
+    srflx << "candidate:" << srflxFoundation << " 1 UDP " << kSrflxPriority
+          << " " << publicIp << " " << port << " typ srflx raddr 0.0.0.0 rport 0";
+    FakeIceCandidateStat stat{statsId(), dom::RTCIceCandidateType::Srflx,
+                              NS_ConvertASCIItoUTF16("udp"), NS_ConvertUTF8toUTF16(publicIp.c_str()),
+                              port, kSrflxPriority,
+                              NS_ConvertASCIItoUTF16(srflxFoundation.c_str()),
+                              false, ufrag16};
+    later(*srflxAt, [self, srflx = srflx.str(), stat, publicIp, port,
+                     transportId, ufrag]() {
+      // The srflx becomes the default candidate, as in stock's SDP.
+      self->mFakeIceDriving = true;
+      self->UpdateDefaultCandidate(publicIp, port, "", 0, transportId);
+      self->mFakeIceDriving = false;
+      // getStats() lists it after the host UDP candidate, as nICEr does.
+      auto& stats = self->mFakeIceStats;
+      stats.insert(stats.begin() + std::min<size_t>(1, stats.size()), stat);
+      self->EmitFakeCandidate(srflx, ufrag);
+    });
+  }
+
+  // Lookups and timeouts report their errors when they end; the last of them
+  // ends gathering, which reports end-of-candidates and then complete.
+  std::vector<std::string> errorsAtEnd;
+  for (const auto& server : servers) {
+    if (server.mOutcome != FakeServerOutcome::FailsLookup &&
+        server.mOutcome != FakeServerOutcome::TimesOut) {
+      continue;
+    }
+    if (server.mAtMs == endAt) {
+      errorsAtEnd.push_back(server.mUrl);
+    } else {
+      later(server.mAtMs, [emitError, url = server.mUrl]() { emitError(url); });
+    }
+  }
+  auto complete = [self, emitError, errorsAtEnd, ufrag]() {
+    for (const auto& url : errorsAtEnd) {
+      emitError(url);
+    }
+    self->EmitFakeCandidate("", ufrag);
+    self->DriveFakeGathering(dom::RTCIceGathererState::Complete);
+  };
+  if (endAt) {
+    later(endAt, std::move(complete));
+  } else {
+    complete();
+  }
+}
+
+void PeerConnectionImpl::StartFakeIceChecks() {
+  // A renegotiation keeps the checks of the first negotiation.
+  if (mFakeChecksStarted) {
+    return;
+  }
+  mFakeChecksStarted = true;
+  const std::string remote =
+      mJsepSession->GetRemoteDescription(kJsepDescriptionPendingOrCurrent);
+  if (remote.find("a=candidate:") != std::string::npos) {
+    DriveFakeIceState(dom::RTCIceTransportState::Checking);
+    ScheduleFakeIceFailure(kFakeIceStunTimeoutMs + FakeIceJitter(30));
+  } else {
+    ScheduleFakeIceFailure(kFakeIceGraceMs + FakeIceJitter(30));
+  }
+}
+
+void PeerConnectionImpl::FakeRemoteCandidate() {
+  if (!mFakeChecksStarted ||
+      mFakeIceState == dom::RTCIceTransportState::Failed) {
+    return;
+  }
+  if (mFakeIceState == dom::RTCIceTransportState::New) {
+    DriveFakeIceState(dom::RTCIceTransportState::Checking);
+  }
+  ScheduleFakeIceFailure(kFakeIceStunTimeoutMs + FakeIceJitter(30));
+}
+
+void PeerConnectionImpl::ScheduleFakeIceFailure(uint32_t aDelayMs) {
+  const uint32_t generation = ++mFakeFailGeneration;
+  RefPtr<PeerConnectionImpl> self(this);
+  FakeIceRunAt(
+      TimeStamp::Now() + TimeDuration::FromMilliseconds(aDelayMs),
+      [self, generation]() {
+        if (self->IsClosed() || generation != self->mFakeFailGeneration ||
+            self->mFakeIceState == dom::RTCIceTransportState::Failed) {
+          return;
+        }
+        self->DriveFakeIceState(dom::RTCIceTransportState::Failed);
+        // The transport is gone, and the data channels with it.
+        if (self->mDataConnection) {
+          self->mDataConnection->CloseAll();
+        }
+      });
+}
