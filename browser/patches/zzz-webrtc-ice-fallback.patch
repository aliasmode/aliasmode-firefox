+// *****
+// AliasMode: the ICE agent behind a proxy without UDP
+// *****
+//
+// With the proxy enforced (media.peerconnection.ice.proxy_only) no UDP leaves
+// the machine around it, and a proxy without UDP (an HTTP proxy) relays none
+// (webrtc-socks5-udp.patch): the real agent would show a machine whose UDP is
+// blocked, with no srflx. It does not gather at all (EnsureIceGathering). The
+// page sees instead what stock Firefox on the identity's network shows, and
+// none of it sends a packet:
+// - host candidates under one mDNS name, the UDP one on a port the identity's
+//   OS would give, numbered as nICEr numbers them;
+// - per configured STUN/TURN server what such a server gives: a srflx with the
+//   proxy's address after a round trip from one that could answer, an
+//   icecandidateerror at once for loopback, after a failed lookup for a name
+//   that cannot resolve, and after nICEr's 11.1 s of retransmissions for an
+//   address that could not answer;
+// - end-of-candidates, then gathering complete, as nICEr signals them;
+// - those candidates in getStats(), and an ICE state of "new";
+// - checks that fail once a remote peer is set: 11.1 s after a remote
+//   candidate, or after the 5 s trickle grace period with none.
+
+namespace {
+
+// nICEr's STUN client sends 7 requests from a 100 ms RTO, doubling, then waits
+// 1600 ms more: a server that never answers fails 11.1 s after the first one.
+constexpr uint32_t kFakeIceStunTimeoutMs = 11100;
+// media.peerconnection.ice.trickle_grace_period: with no remote candidate,
+// checks fail this long after they could start.
+constexpr uint32_t kFakeIceGraceMs = 5000;
+
+uint32_t FakeIceJitter(uint32_t aMax) {
+  return static_cast<uint32_t>(mozilla::RandomUint64OrDie() % (aMax + 1));
+}
+
+// Runs aStep on the main thread at aDeadline. A timer may fire up to an eighth
+// of its delay late to be bundled with others, so this waits in steps of at
+// most 500 ms, each toward the same deadline, to end where nICEr's timers do.
+void FakeIceRunAt(TimeStamp aDeadline, std::function<void()>&& aStep) {
+  const double remaining = (aDeadline - TimeStamp::Now()).ToMilliseconds();
+  if (remaining <= 0) {
+    aStep();
+    return;
+  }
+  const uint32_t wait = static_cast<uint32_t>(std::ceil(std::min(remaining, 500.0)));
+  GetMainThreadSerialEventTarget()->DelayedDispatch(
+      NS_NewRunnableFunction("PeerConnectionImpl::FakeIceRunAt",
+                             [aDeadline, step = std::move(aStep)]() mutable {
+                               FakeIceRunAt(aDeadline, std::move(step));
+                             }),
+      wait);
+}
+
+enum class FakeServerOutcome { Answers, FailsAtOnce, FailsLookup, TimesOut };
+
+struct FakeIceServer {
+  std::string mUrl;  // as icecandidateerror reports it
+  // What nICEr tells servers apart by when it numbers candidates: the
+  // address; names are not resolved yet then, so all names count as one.
+  std::string mKey;
+  bool mTurn = false;
+  FakeServerOutcome mOutcome = FakeServerOutcome::TimesOut;
+  uint32_t mAtMs = 0;
+};
+
+// The UDP STUN and TURN servers of the configuration, in order, with what
+// each gives a host whose public address is the proxy's. aRoundTripMs is the
+// round trip through the proxy a STUN answer would take (0: unknown).
+std::vector<FakeIceServer> PlanFakeIceServers(
+    const RTCConfigurationInternal& aConfig, uint32_t aRoundTripMs) {
+  // A STUN answer comes one round trip after the request, from wherever the
+  // proxy is; a little more for the time a real exchange spends in sockets.
+  // Without a measurement, a nearby server's round trip.
+  const auto answerMs = [aRoundTripMs] {
+    if (!aRoundTripMs) {
+      return 12 + FakeIceJitter(48);
+    }
+    const uint32_t rtt = std::max<uint32_t>(aRoundTripMs, 8);
+    return rtt + FakeIceJitter(rtt / 10) + 1 + FakeIceJitter(4);
+  };
+  static const nsLiteralCString kSpecialUse[] = {
+      ".localhost"_ns, ".local"_ns, ".invalid"_ns,   ".test"_ns, ".example"_ns,
+      ".internal"_ns,  ".onion"_ns, ".home.arpa"_ns, ".alt"_ns};
+  std::vector<FakeIceServer> servers;
+  for (const auto& server : aConfig.mIceServers) {
+    for (const auto& url : server.mUrls) {
+      auto parsed =
+          IceServerParser::ParseStunTurnUri(NS_ConvertUTF16toUTF8(url));
+      if (parsed.isErr()) {
+        parsed.unwrapErr().SuppressException();
+        continue;
+      }
+      const auto& uri = parsed.inspect();
+      // A UDP gather uses UDP servers only.
+      if (uri.IsTls() || uri.mTransport != IceServerParser::IceTransport::Udp) {
+        continue;
+      }
+      nsAutoCString host(uri.mHost);
+      if (StringBeginsWith(host, "["_ns) && StringEndsWith(host, "]"_ns)) {
+        host = Substring(host, 1, host.Length() - 2);
+      }
+      FakeIceServer fake;
+      fake.mTurn = uri.IsTurn();
+      fake.mUrl = std::string(fake.mTurn ? "turn:" : "stun:") + uri.mHost.get() +
+                  ":" + std::to_string(uri.mPort);
+      net::NetAddr addr;
+      if (NS_SUCCEEDED(addr.InitFromString(host))) {
+        if (addr.raw.family == AF_INET6) {
+          // The host gathers on IPv4; nICEr skips a server of the other family.
+          continue;
+        }
+        fake.mKey = host.get();
+        if (addr.IsLoopbackAddr()) {
+          // A closed port on this machine answers with ICMP at once.
+          fake.mOutcome = FakeServerOutcome::FailsAtOnce;
+        } else if (addr.IsIPAddrAny() || addr.IsIPAddrLocal() ||
+                   addr.IsIPAddrShared()) {
+          fake.mOutcome = FakeServerOutcome::TimesOut;
+          fake.mAtMs = kFakeIceStunTimeoutMs + FakeIceJitter(15);
+        } else {
+          fake.mOutcome = FakeServerOutcome::Answers;
+          fake.mAtMs = answerMs();
+        }
+      } else {
+        ToLowerCase(host);
+        const nsAutoCString dotted("."_ns + host);
+        bool special = host.FindChar('.') < 0;
+        for (const auto& suffix : kSpecialUse) {
+          special |= StringEndsWith(dotted, suffix);
+        }
+        if (special) {
+          fake.mOutcome = FakeServerOutcome::FailsLookup;
+          fake.mAtMs = 2 + FakeIceJitter(10);
+        } else {
+          // Not resolved here: a lookup from this machine would reach its own
+          // resolver around the proxy.
+          // The name's lookup comes first.
+          fake.mOutcome = FakeServerOutcome::Answers;
+          fake.mAtMs = answerMs() + 2 + FakeIceJitter(10);
+        }
+      }
+      servers.push_back(std::move(fake));
+    }
+  }
+  return servers;
+}
+
+}  // namespace
+
+// The round trip through the proxy, as the page's own loads measured it: the
+// shortest TLS handshake (one round trip to a server through the proxy) or
+// wait for a first byte among the document and the resources whose timing the
+// page may read, leaving out those from the cache. 0 when there is no such
+// measurement, as for loads from the cache or from this machine.
+uint32_t PeerConnectionImpl::ProxyRoundTripMs() const {
+  if (!mWindow) {
+    return 0;
+  }
+  RefPtr<dom::Performance> performance = mWindow->GetPerformance();
+  Document* doc = mWindow->GetExtantDoc();
+  if (!performance || !doc) {
+    return 0;
+  }
+  nsIPrincipal& principal = *doc->NodePrincipal();
+  double best = 0;
+  const auto consider = [&best](double aMs) {
+    if (aMs >= 2 && (!best || aMs < best)) {
+      best = aMs;
+    }
+  };
+  for (const auto& type : {u"navigation"_ns, u"resource"_ns}) {
+    nsTArray<RefPtr<dom::PerformanceEntry>> entries;
+    performance->GetEntriesByType(type, entries);
+    for (const auto& entry : entries) {
+      const dom::PerformanceResourceTiming* timing = entry->ToResourceTiming();
+      if (!timing || !timing->TransferSize(principal)) {
+        continue;
+      }
+      const double secureStart = timing->SecureConnectionStart(principal);
+      const double connectEnd = timing->ConnectEnd(principal);
+      if (secureStart > 0 && connectEnd > secureStart) {
+        consider(connectEnd - secureStart);
+      }
+      const double requestStart = timing->RequestStart(principal);
+      const double responseStart = timing->ResponseStart(principal);
+      if (requestStart > 0 && responseStart > requestStart) {
+        consider(responseStart - requestStart);
+      }
+    }
+  }
+  return static_cast<uint32_t>(std::min(best, 2000.0));
+}
